generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model USER {
  id            String          @id
  email         String          @unique
  name          String
  photoUrl      String
  college       String?
  branch        String?
  year          Int?
  oAuthProvider String
  refreshToken String
  historyId String?
  categories    CATEGORIES[]
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  settings  Json @default("{\"SyncCalender\": \"true\", \"Reminders\": \"true\" }")
  isWatching Boolean @default(false)
  exp DateTime?
  sessions Json[] @default([])
  fids Json[] @default([])
  emails        EMAILS[]
  notifications notifications[]
}


model EMAILS {
  id         String   @id
  userId     String
  gmailId    String @unique
  subject    String
  GmailSubject String
  sender     String
  summary    String
  body       Json
  receivedAt DateTime
  aiPriority   String
  priority String
  category   String
  deadline   DateTime?
  isRead     Boolean
  lastOpenedAt DateTime?
  requiresAction Boolean
  importance Int
  urgency Int
  senderImportance Int
  isCompleted Boolean
  tags       String[]
  isStared Boolean @default(false)
  updatedAt  DateTime @updatedAt @default(now())
  User       USER     @relation(fields: [userId], references: [id])
  attachments ATTACHMENTS[]
}

model notifications {
  id            String   @id
  userId        String
  title         String
  body          String
  scheduledTime DateTime
  isSent        Boolean
  data Json? 
  seen Boolean @default(false)
  User          USER     @relation(fields: [userId], references: [id])
}

model ATTACHMENTS {
  file String
  attachmentId String @id
  mimetype String
  gmailId String
  emailId String
  email EMAILS @relation(fields: [emailId], references: [id])
}

model CATEGORIES {
  id String @id
  name String
  userId String
  user USER @relation(fields: [userId], references: [id])
}